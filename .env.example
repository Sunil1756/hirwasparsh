# ====================================================================
# Green Enlightenment — Environment Variables Template
# ====================================================================
# Copy this file to .env or .env.local for local development.
# In production, configure these variables in GitHub Secrets and Vercel Project Settings.

# --------------------------------------------------------------------
# 1. Supabase Infrastructure (Required for Database & Auth)
# --------------------------------------------------------------------
# Your Supabase Project HTTPS URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://hirwasparsh-project.supabase.co

# Your Supabase Anonymous / Public API Key (JWT)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholderKeyForClientSafeInit

# --------------------------------------------------------------------
# 2. Copernicus Sentinel-2 Satellite API (Live Multi-Spectral Pipeline)
# --------------------------------------------------------------------
# Official Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub OAuth Credentials
VITE_COPERNICUS_CLIENT_ID=sh-bca04d51-5029-419e-a9d2-29b4cb7ae6fa
VITE_COPERNICUS_CLIENT_SECRET=65bC8ZTF2Uu4Vy9nBV8Tg6q6ldXAxenF
COPERNICUS_CLIENT_ID=sh-bca04d51-5029-419e-a9d2-29b4cb7ae6fa
COPERNICUS_CLIENT_SECRET=65bC8ZTF2Uu4Vy9nBV8Tg6q6ldXAxenF

# --------------------------------------------------------------------
# 3. AI Botanical Vision & Intelligence (Optional / Recommended)
# --------------------------------------------------------------------
# Google Gemini 1.5 Flash API Key for botanical disease analysis and voice assistance
VITE_GEMINI_API_KEY=AIzaSyPlaceholderGeminiKeyForLocalDevelopment

# --------------------------------------------------------------------
# 4. PostHog & Telemetry Analytics (Optional / Recommended)
# --------------------------------------------------------------------
# PostHog Project API Key (e.g. phc_xxxxxxxxxxxxxxxxxxxxxxxxxxx)
VITE_POSTHOG_KEY=phc_green_enlightenment_live_analytics

# PostHog Ingestion Host (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --------------------------------------------------------------------
# 5. Twilio SMS OTP Gateway (Live Mobile Verification)
# --------------------------------------------------------------------
# Twilio Account SID (found in Twilio Console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token (click copy icon in Twilio Console)
TWILIO_AUTH_TOKEN=your_full_twilio_auth_token_here

# Twilio Active Phone Number (e.g. +1234567890)
TWILIO_FROM_NUMBER=+1234567890


# --------------------------------------------------------------------
# 6. CI/CD & Vercel Automated Deployments (Configured in GitHub Secrets)
# --------------------------------------------------------------------
# Vercel Personal Access Token (generate at https://vercel.com/account/tokens)
# VERCEL_TOKEN=vercel_token_placeholder

# Vercel Organization / Team ID (found in Project Settings or .vercel/project.json)
# VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Project ID (found in Vercel Project Settings)
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxx

